// Scope inspection to the probe PID and the OS authorization UI. Output only
// the matching authorization alert, never unrelated Notification Center items.
function run(args){
  const se=Application('System Events');const pid=Number(args[0]);
  const processes=se.processes().filter(p=>Number(p.unixId())===pid||String(p.bundleIdentifier()).startsWith('com.polterware.sparky.spike2.authorization')||['UserNotificationCenter','CoreServicesUIAgent','NotificationCenter'].includes(p.name()));
  function walk(x,depth=0){if(depth>12)return [];const v=x.properties();return [{x,role:v.role,name:v.name,description:v.description,value:v.value},...x.uiElements().flatMap(c=>walk(c,depth+1))];}
  for(const p of processes)for(const w of p.windows()){
    const nodes=walk(w), text=nodes.map(n=>[n.name,n.description,n.value].filter(Boolean).join(' | ')).filter(Boolean);
    if(!text.some(t=>t.includes('Sparky'))||!text.some(t=>/notif/i.test(t)))continue;
    const deny=nodes.find(n=>n.role==='AXButton'&&["Don’t Allow","Don't Allow","Não Permitir"].some(label=>[n.name,n.description].includes(label)));
    const result={found:true,promptText:text.filter(t=>/Sparky|notif|Allow|Permitir|alert|sound|badge/i.test(t)),buttons:nodes.filter(n=>n.role==='AXButton').map(n=>n.name||n.description),observedAtMs:Date.now(),denied:!!deny};
    if(deny)deny.x.actions.byName('AXPress').perform();
    return JSON.stringify(result);
  }
  return JSON.stringify({found:false,surfaces:processes.map(p=>({name:p.name(),windows:p.windows().length}))});
}
