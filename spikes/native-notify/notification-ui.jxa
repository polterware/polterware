// Use Accessibility actions on synthetic W0 notifications only. No screenshots.
function run(args) {
  const target=args[0], action=args[1];
  if(!target.startsWith('W0 ')) throw Error('Only synthetic W0 titles are allowed');
  const p=Application('System Events').processes.byName('NotificationCenter');
  function tree(x,depth=0) {
    if(depth>16)return null;
    const props=x.properties();
    return {x,role:props.role,subrole:props.subrole,text:[props.name,props.description,props.value].join(' | '),
      children:x.uiElements().map(c=>tree(c,depth+1)).filter(Boolean)};
  }
  function contains(t){return t.text.includes(target)||t.children.some(contains)}
  function flat(t){return [t,...t.children.flatMap(flat)]}
  function locate(){
    for(const w of p.windows()){
      const t=tree(w);
      if(contains(t)){
        const nodes=flat(t);
        // The nearest banner/container containing the exact synthetic title.
        return nodes.filter(n=>contains(n)).reverse().find(n=>n.role==='AXGroup') || t;
      }
    }
  }
  let hit=locate();
  if(!hit)return JSON.stringify({target,found:false});
  if(action){
    const show=hit.x.actions().find(a=>a.name().includes('Show Details'));
    if(show){show.perform();delay(0.2);hit=locate()||hit;}
    const direct=hit.x.actions().find(a=>a.name().startsWith('Name:'+action+'\n'));
    if(direct){const clickAtMs=Date.now();direct.perform();return JSON.stringify({target,found:true,clicked:true,action,mechanism:'NotificationCenter AX custom action',clickAtMs,returnedAtMs:Date.now()});}
    let nodes=flat(hit);
    const more=nodes.find(n=>n.role==='AXMenuButton' && n.text.includes('More Actions'));
    if(more){more.x.actions.byName('AXPress').perform();delay(0.2);nodes=flat(tree(more.x));}
    const button=nodes.find(n=>['AXButton','AXMenuItem'].includes(n.role) && [n.x.name(),n.x.description()].includes(action));
    if(button){const clickAtMs=Date.now();button.x.actions.byName('AXPress').perform();return JSON.stringify({target,found:true,clicked:true,action,clickAtMs,returnedAtMs:Date.now()});}
  }
  return JSON.stringify({target,found:true,clicked:false,ownNodes:flat(hit).map(n=>({role:n.role,text:n.text,actions:n.x.actions().map(a=>a.name())}))});
}
