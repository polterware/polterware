{
  "name": "search_memories",
  "description": "Ranked full-text search.",
  "inputSchema": {
    "type": "object",
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string"
      },
      "mind": {
        "type": "string"
      },
      "tag": {
        "type": "string"
      },
      "limit": {
        "type": "integer"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "hits"
    ],
    "properties": {
      "hits": {
        "type": "array"
      },
      "notice": {
        "type": "string"
      }
    }
  }
}
