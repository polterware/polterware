{
  "name": "delete_mind",
  "description": "Delete a mind and its children. Memories move to Inbox. confirm true.",
  "inputSchema": {
    "type": "object",
    "required": [
      "confirm"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "confirm": {
        "const": true
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "deletedMindIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "movedMemoryCount": {
        "type": "integer"
      }
    }
  }
}
