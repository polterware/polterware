      "method": "POST",
      "path": "/polterware.local.v1.HealthService/Check",
      "token": null,
      "content_type": "application/json",
      "status": 200,
      "response_content_type": "application/json",
      "accept_post": "",
      "allow": "",
      "body": "{}",
      "response": "{\"status\": \"ok\", \"version\": \"0.1.0\", \"uptimeSec\": \"<masked>\", \"build\": \"<masked>\", \"pid\": \"<masked>\"}"
    },
