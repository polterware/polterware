{
  "name": "@polterware/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop shell for Polterware.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "pnpm build && electron-builder --mac --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "deps:electron": "node -e \"const pkg = require('./package.json'); console.log(pkg.devDependencies.electron);\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "echo e2e via go integration gate"
  },
  "dependencies": {
    "@polterware/feature-architecture": "workspace:*",
    "@polterware/feature-commander": "workspace:*",
    "@polterware/feature-integrations": "workspace:*",
    "@polterware/feature-knowledge": "workspace:*",
    "@polterware/feature-operations": "workspace:*",
    "@polterware/feature-resources": "workspace:*",
    "@polterware/feature-settings": "workspace:*",
    "@polterware/feature-shell": "workspace:*",
    "@polterware/frontend-design-system": "workspace:*",
    "@polterware/frontend-state": "workspace:*",
    "@tanstack/solid-virtual": "3.13.12",
    "electron-updater": "^6.8.9",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.12.2",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-log": "^5.4.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.2",
    "solid-js": "^1.9.5",
    "tailwindcss": "^4.1.12",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.5"
  }
}
