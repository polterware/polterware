{
  "name": "@polterware/sparky-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop shell for Sparky.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm build:native && pnpm --dir ../.. build:sparky-core && electron-vite dev",
    "build:native": "bash native/scripts/build.sh",
    "build": "pnpm build:native && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "pnpm --dir ../.. build:sparky-core && pnpm build && electron-builder --mac --publish never",
    "dist:mac": "pnpm --dir ../.. build:sparky-core && pnpm build && electron-builder --mac --publish never",
    "deps:electron": "node -e \"const pkg = require('./package.json'); console.log(pkg.devDependencies.electron);\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src/main src/preload",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@polterware/feature-sparky-attachments": "workspace:*",
    "@polterware/feature-sparky-calendar": "workspace:*",
    "@polterware/feature-sparky-focus": "workspace:*",
    "@polterware/feature-sparky-map": "workspace:*",
    "@polterware/feature-sparky-memories": "workspace:*",
    "@polterware/feature-sparky-minds": "workspace:*",
    "@polterware/feature-sparky-review": "workspace:*",
    "@polterware/feature-sparky-schedule": "workspace:*",
    "@polterware/feature-sparky-search": "workspace:*",
    "@polterware/feature-sparky-settings": "workspace:*",
    "@polterware/feature-sparky-shell": "workspace:*",
    "@polterware/frontend-design-system": "workspace:*",
    "@polterware/sparky-contracts": "workspace:*",
    "electron-updater": "^6.8.9",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  }
}
