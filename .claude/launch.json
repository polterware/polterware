{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "polterware",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@polterware/polterware-desktop",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "gallery",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@polterware/gallery",
        "run",
        "dev"
      ],
      "port": 5177,
      "url": "http://127.0.0.1:5177"
    }
  ]
}
