{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "cache": false,
      "outputs": [
        "backend/platform/gen/**",
        "packages/contracts/src/gen/**",
        "sparky/backend/platform/gen/**",
        "packages/sparky-contracts/src/gen/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["SPARKY_CORE_DB", "SPARKY_CORE_BIN", "SPARKY_CORE_ENDPOINT", "SPARKY_CORE_TOKEN", "REMOTE_DEBUGGING_PORT", "ELECTRON_CLI_ARGS"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".output/**"]
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "dist": {
      "dependsOn": ["build"],
      "outputs": ["release/**"]
    },
    "dist:mac": {
      "dependsOn": ["build"],
      "outputs": ["release/**"]
    },
    "dist:win": {
      "dependsOn": ["build"],
      "outputs": ["release/**"]
    },
    "dist:linux": {
      "dependsOn": ["build"],
      "outputs": ["release/**"]
    },
    "dist:all": {
      "dependsOn": ["build"],
      "outputs": ["release/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "design:lint": {
      "outputs": []
    },
    "deps:electron": {
      "outputs": []
    }
  }
}
