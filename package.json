{
  "name": "@polterware/workspace",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:lore": "turbo run dev --filter=@polterware/lore-desktop",
    "dev:sparky": "turbo run dev --filter=@polterware/sparky-desktop",
    "dev:vitals": "turbo run dev --filter=@polterware/vitals",
    "dev:web": "turbo run dev --filter=@polterware/web",
    "dev:gallery": "turbo run dev --filter=@polterware/gallery",
    "dev:core": "bash scripts/dev.sh --core-only",
    "build": "turbo run build",
    "build:lore": "turbo run build --filter=@polterware/lore-desktop",
    "build:sparky": "turbo run build --filter=@polterware/sparky-desktop",
    "build:vitals": "turbo run build --filter=@polterware/vitals",
    "build:web": "turbo run build --filter=@polterware/web",
    "build:gallery": "turbo run build --filter=@polterware/gallery",
    "build:cli": "mkdir -p dist && cd backend && go build -o ../dist/polterware ./runtimes/cli",
    "build:sparky-core": "mkdir -p dist && cd sparky/backend && go build -o ../../dist/sparky ./runtimes/cli",
    "preview": "turbo run preview",
    "preview:lore": "turbo run preview --filter=@polterware/lore-desktop",
    "preview:sparky": "turbo run preview --filter=@polterware/sparky-desktop",
    "preview:vitals": "turbo run preview --filter=@polterware/vitals",
    "preview:web": "turbo run preview --filter=@polterware/web",
    "typecheck": "turbo run typecheck",
    "typecheck:lore": "turbo run typecheck --filter=@polterware/lore-desktop...",
    "typecheck:sparky": "pnpm --filter \"@polterware/*sparky*\" typecheck",
    "typecheck:vitals": "turbo run typecheck --filter=@polterware/vitals...",
    "typecheck:web": "turbo run typecheck --filter=@polterware/web...",
    "test": "turbo run test",
    "test:lore": "turbo run test --filter=@polterware/lore-desktop...",
    "test:sparky": "pnpm --filter \"@polterware/*sparky*\" test",
    "test:vitals": "turbo run test --filter=@polterware/vitals...",
    "test:e2e:sparky": "pnpm --filter @polterware/sparky-desktop test:e2e",
    "test:integration": "bash tooling/test-integration.sh",
    "test:security": "bash tooling/test-security.sh",
    "test:ui-opacity": "node --test tooling/check-ui-opacity.test.mjs",
    "dist:lore:mac": "bash tooling/release/dist-mac.sh lore",
    "dist:sparky:mac": "bash tooling/release/dist-mac.sh sparky",
    "dist:vitals:mac": "bash tooling/release/dist-mac.sh vitals",
    "deps:electron": "turbo run deps:electron --filter=@polterware/lore-desktop",
    "lint": "oxlint . && (turbo run lint --continue || true)",
    "format:check": "echo 'format:check ok (prettier optional until packages wired)'",
    "design:lint": "node tooling/check-ui-opacity.mjs",
    "generate": "bash tooling/generate.sh",
    "verify": "bash tooling/verify.sh",
    "verify:sparky": "bash tooling/verify-sparky.sh"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "oxlint": "1.85.0",
    "turbo": "^2.11.3",
    "typescript": "7.0.2"
  }
}
